{
  "name": "naiyi-translate",
  "private": true,
  "version": "0.1.5",
  "description": "Inline bilingual reading with scroll-loaded translations and Google, Microsoft, or OpenAI-compatible engines.",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "test": "node tests/run.mjs logic && node tests/run.mjs dom",
    "test:live": "node tests/run.mjs live"
  },
  "license": "GPL-3.0",
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "jsdom": "^30.1.2",
    "obsidian": "^1.7.2",
    "typescript": "5.4.5"
  },
  "author": "Meatballovsky",
  "repository": {
    "type": "git",
    "url": "https://github.com/Meatballovsky/obsidian-naiyi-translator.git"
  },
  "bugs": {
    "url": "https://github.com/Meatballovsky/obsidian-naiyi-translator/issues"
  },
  "homepage": "https://github.com/Meatballovsky/obsidian-naiyi-translator#readme"
}
